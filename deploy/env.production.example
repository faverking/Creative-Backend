NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://121.41.223.169,http://121.41.223.169:3000,http://121.41.223.169:5173,http://121.41.223.169:5174

MONGO_URI=mongodb://127.0.0.1:27017/mononest
# MONGO_URI=mongodb://127.0.0.1:27017/mononest?replicaSet=rs0
MONGO_DB_NAME=mononest
MONGO_SYNC_INDEXES_ON_BOOT=false
MONGO_REQUIRE_TRANSACTIONS=true

REDIS_ENABLED=false
REDIS_URL=

JWT_ACCESS_SECRET=replace_with_a_strong_random_access_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

AUTH_ENABLE_OAUTH=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=

THROTTLE_TTL=60
THROTTLE_LIMIT=120
REQUEST_BODY_LIMIT=20mb

OPENAI_API_KEY=replace_with_server_openai_api_key_or_internal_proxy_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ADMIN_COMPOSE=gpt-5.4-mini
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_INPUT_CHARS=12000
OPENAI_MAX_OUTPUT_TOKENS=1200
AI_ADMIN_STREAM_ENABLED=true

MEDIA_STORAGE_ROOT=/var/lib/mononest/media
MEDIA_IMAGE_MAX_FILE_SIZE=20971520
MEDIA_AUDIO_MAX_FILE_SIZE=52428800
MEDIA_BATCH_UPLOAD_LIMIT=20
MEDIA_IO_CONCURRENCY=2
MEDIA_IMAGE_PREVIEW_LONG_EDGE=1280
MEDIA_IMAGE_PREVIEW_SHORT_EDGE=480
MEDIA_IMAGE_PREVIEW_WEBP_QUALITY=80
MEDIA_IMAGE_PREVIEW_CONCURRENCY=1
MEDIA_IMAGE_MAX_PIXELS=100000000
MEDIA_ZIP_MAX_FILE_SIZE=104857600
MEDIA_ZIP_ENTRY_LIMIT=100
MEDIA_ZIP_ENTRY_MAX_FILE_SIZE=52428800
MEDIA_ZIP_DOWNLOAD_MAX_ITEMS=100
MEDIA_ZIP_DOWNLOAD_MAX_TOTAL_SIZE=262144000
